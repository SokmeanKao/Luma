{
  "name": "@luma/desktop",
  "version": "0.0.0",
  "private": true,
  "author": "Luma",
  "description": "Electron Windows client — Phase A shell + floating subtitles",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm --filter @luma/win-audio build && electron-vite dev",
    "build": "pnpm --filter @luma/win-audio build && electron-vite build",
    "dist:msi": "pnpm run build && electron-builder --win msi --x64 --config electron-builder.yml",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@luma/audio": "workspace:*",
    "@luma/translation": "workspace:*",
    "@luma/ui": "workspace:*",
    "@luma/win-audio": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "24.13.3",
    "electron-vite": "^3.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.5"
  }
}
