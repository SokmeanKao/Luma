# Go API (server-side only — NEVER prefix these with NEXT_PUBLIC_)
BIND_ADDR=127.0.0.1:8080
ALLOWED_ORIGINS=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=
ENABLE_LIVE_TOKEN_MINT=false
DEMO_MODE=true

# Web (public; no secrets)
NEXT_PUBLIC_LUMA_MODE=demo
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080
